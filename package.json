{
  "name": "blanch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,convex -c magenta,cyan \"next dev\" \"convex dev\"",
    "build": "next build",
    "start": "next start",
    "setup": "tsx scripts/setup.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "workos:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/workos-bootstrap.ts"
  },
  "dependencies": {

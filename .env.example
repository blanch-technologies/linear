# Copied to .env.local by `pnpm setup`. Validated by src/lib/env/schema.ts.

# Convex. `npx convex dev` (run by `pnpm setup`) fills these in.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# WorkOS AuthKit, staging environment (dashboard.workos.com > API keys).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# 32+ random characters; `pnpm setup` generates one.
WORKOS_COOKIE_PASSWORD=
# Must also be listed under Redirects in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Sentry (optional locally).
NEXT_PUBLIC_SENTRY_DSN=

# Test-only auth path for e2e (D-41). The app refuses to boot with 1 in production.
BLANCH_TEST_AUTH=0
